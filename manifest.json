{
  "manifest_version": 3,
  "name": "Tab Vault",
  "version": "1.0.0",
  "description": "Save open tabs into one merged, de-duplicated, URL-sorted list.",
  "permissions": ["tabs", "storage", "unlimitedStorage", "favicon", "downloads", "alarms", "offscreen"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Save all tabs to Tab Vault",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "save-all": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save all open tabs to the common list"
    }
  }
}
